<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"

    android:descendantFocusability="afterDescendants"
    android:focusableInTouchMode="true"
    android:scrollIndicators="none"
    tools:context=".view.login.RegisterFragment">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:orientation="vertical">


        <!-- TODO: Update blank fragment layout -->
        <TextView
            style="@style/header_textview_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40dp"
            android:gravity="center"
            android:text="Register"
            android:textSize="22sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            style="@style/textInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:hint="User Name"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            >

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/tieFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:imeOptions="actionNext"
                android:inputType="text|textPersonName"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="50"


                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMobile"
            style="@style/textInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:hint="Mobile Number"
            android:paddingBottom="0dp"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            >

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/tieMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:ems="10"

                android:imeOptions="actionNext"

                android:inputType="phone"
                android:maxLength="10"
                android:nextFocusDown="@+id/etAddress"
                android:singleLine="true"
                android:maxLines="1"

                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            style="@style/textInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:hint="Address"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            >

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/tieAddresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="start|top"
                android:inputType="textMultiLine"
                android:lines="3"
                android:maxLength="150"
                android:maxLines="3"
                android:minLines="3"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:scrollbars="vertical"

                android:nextFocusDown="@+id/textInputLayoutDateOfBirth"

                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutDateOfBirth"
            style="@style/textInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:hint="Date of Birth"

            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_calendar"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            app:placeholderText="dd-mm-yyyy"
            app:placeholderTextColor="@color/color_grey"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:digits="0123456789"

            android:textColorHint="@color/gray_btn_bg_color"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:maxLength="10"
                android:nextFocusDown="@+id/autoCompleteOccupationType"
                tools:ignore="TextFieldWithShortText" />





        </com.google.android.material.textfield.TextInputLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/padding_50"
            android:layout_marginTop="16dp"
            android:background="#DDDDDD" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGenderLabel"
                style="@style/regular_primary_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:fontFamily="@font/poppinsregular"
                android:text="Select Gender" />

            <!-- RadioGroup for Gender -->
            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16dp"
                android:layout_weight="1"
                android:gravity="left"
                android:orientation="horizontal">

                <!-- Male Radio Button -->
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbMale"
                    style="@style/semibold_primary_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"

                    android:button="@drawable/radio_selector"
                    android:checked="true"
                    android:paddingLeft="@dimen/_8dp"
                    android:text="Male"
                    android:textColor="@color/black" />

                <!-- Female Radio Button -->
                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbFemale"
                    style="@style/semibold_primary_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/radio_selector"
                    android:paddingLeft="@dimen/_8dp"
                    android:text="Female" />
            </RadioGroup>


        </LinearLayout>

        <TextView
            android:id="@+id/tvGenderError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/design_default_color_error"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Please select a gender." />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOccupationType1"

            style="@style/dropdownInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            android:hint="Occupation Type"


            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            app:boxBackgroundMode="outline"
            >

            <!-- Use MaterialAutoCompleteTextView for full Material Design compatibility -->
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoCompleteOccupationType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="yes"
                android:inputType="none"
                android:imeOptions="actionDone"
                android:maxLength="50"
                android:nextFocusDown="@+id/etAddress"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollHorizontally="true"
                tools:ignore="KeyboardInaccessibleWidget,SpeakableTextPresentCheck,SpeakableTextPresentCheck"

                />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tilOccupationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8dp"
            style="@style/dropdownInputLayoutStyle"
            app:startIconDrawable="@drawable/ic_report_24"
            app:errorEnabled="true"
           >

            <!-- Inside text input layout add
                  an auto complete text view
                    and make its input type to none-->
            <AutoCompleteTextView
                android:id="@+id/autoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="none"
                android:dropDownHeight="200dp"
                android:dropDownVerticalOffset="4dp"
                android:hint="Occupation Type"

               />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/ButtonStyle.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16dp"
            android:text="Register">

        </com.google.android.material.button.MaterialButton>
    </LinearLayout>
</ScrollView>